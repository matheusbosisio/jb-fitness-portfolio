generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductSize {
  NO_SIZE
  P
  M
  G
  GG
}

enum PaymentMethod {
  PIX
  CASH
  DEBIT_CARD
  CREDIT_CARD
}

enum SaleStatus {
  COMPLETED
  CANCELLED
}

enum StockEntryStatus {
  POSTED
  CORRECTED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(120)
  email        String   @unique @db.VarChar(254)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdStockEntries StockEntry[] @relation("StockEntryCreator")
  createdSales        Sale[]       @relation("SaleCreator")
  cancelledSales      Sale[]       @relation("SaleCanceller")
  sessions            Session[]

  @@map("users")
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  tokenHash  String   @unique @map("token_hash") @db.Char(64)
  userId     String   @map("user_id") @db.Uuid
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt DateTime @default(now()) @map("last_used_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Category {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @db.VarChar(80)
  normalizedName String   @unique @map("normalized_name") @db.VarChar(80)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  products Product[]

  @@index([active])
  @@map("categories")
}

model Product {
  id             String   @id @default(uuid()) @db.Uuid
  categoryId     String   @map("category_id") @db.Uuid
  name           String   @db.VarChar(140)
  normalizedName String   @unique @map("normalized_name") @db.VarChar(140)
  description    String?  @db.Text
  salePrice      Decimal  @map("sale_price") @db.Decimal(14, 2)
  imageKey       String?  @map("image_key") @db.VarChar(500)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  category Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants ProductVariant[]

  @@index([categoryId])
  @@index([active])
  @@map("products")
}

model ProductVariant {
  id              String      @id @default(uuid()) @db.Uuid
  productId       String      @map("product_id") @db.Uuid
  color           String?     @db.VarChar(60)
  normalizedColor String      @default("") @map("normalized_color") @db.VarChar(60)
  size            ProductSize @default(NO_SIZE)
  stockQuantity   Int         @default(0) @map("stock_quantity")
  averageUnitCost Decimal     @default(0) @map("average_unit_cost") @db.Decimal(14, 4)
  active          Boolean     @default(true)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  product         Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  stockEntryItems StockEntryItem[]
  saleItems       SaleItem[]

  @@unique([productId, normalizedColor, size])
  @@index([productId, active])
  @@map("product_variants")
}

model StockEntry {
  id              String           @id @default(uuid()) @db.Uuid
  status          StockEntryStatus @default(POSTED)
  occurredAt      DateTime         @map("occurred_at") @db.Timestamptz(3)
  notes           String?          @db.VarChar(500)
  createdById     String           @map("created_by_id") @db.Uuid
  replacesEntryId String?          @unique @map("replaces_entry_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  createdBy     User             @relation("StockEntryCreator", fields: [createdById], references: [id], onDelete: Restrict)
  replacesEntry StockEntry?      @relation("StockEntryCorrections", fields: [replacesEntryId], references: [id], onDelete: Restrict)
  replacement   StockEntry?      @relation("StockEntryCorrections")
  items         StockEntryItem[]

  @@index([occurredAt])
  @@index([status, occurredAt])
  @@index([createdById])
  @@map("stock_entries")
}

model StockEntryItem {
  id                   String   @id @default(uuid()) @db.Uuid
  stockEntryId         String   @map("stock_entry_id") @db.Uuid
  productVariantId     String   @map("product_variant_id") @db.Uuid
  quantity             Int
  unitCost             Decimal  @map("unit_cost") @db.Decimal(14, 4)
  previousQuantity     Int      @map("previous_quantity")
  previousAverageCost  Decimal  @map("previous_average_cost") @db.Decimal(14, 4)
  resultingQuantity    Int      @map("resulting_quantity")
  resultingAverageCost Decimal  @map("resulting_average_cost") @db.Decimal(14, 4)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  stockEntry     StockEntry     @relation(fields: [stockEntryId], references: [id], onDelete: Restrict)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@unique([stockEntryId, productVariantId])
  @@index([productVariantId])
  @@map("stock_entry_items")
}

model Sale {
  id                 String        @id @default(uuid()) @db.Uuid
  status             SaleStatus    @default(COMPLETED)
  paymentMethod      PaymentMethod @map("payment_method")
  soldAt             DateTime      @map("sold_at") @db.Timestamptz(3)
  totalRevenue       Decimal       @map("total_revenue") @db.Decimal(14, 2)
  totalCost          Decimal       @map("total_cost") @db.Decimal(14, 2)
  totalGrossProfit   Decimal       @map("total_gross_profit") @db.Decimal(14, 2)
  createdById        String        @map("created_by_id") @db.Uuid
  cancelledAt        DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  cancelledById      String?       @map("cancelled_by_id") @db.Uuid
  cancellationReason String?       @map("cancellation_reason") @db.VarChar(500)
  replacesSaleId     String?       @unique @map("replaces_sale_id") @db.Uuid
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy    User       @relation("SaleCreator", fields: [createdById], references: [id], onDelete: Restrict)
  cancelledBy  User?      @relation("SaleCanceller", fields: [cancelledById], references: [id], onDelete: Restrict)
  replacesSale Sale?      @relation("SaleCorrections", fields: [replacesSaleId], references: [id], onDelete: Restrict)
  replacement  Sale?      @relation("SaleCorrections")
  items        SaleItem[]

  @@index([status, soldAt])
  @@index([paymentMethod, soldAt])
  @@index([createdById])
  @@index([cancelledById])
  @@map("sales")
}

model SaleItem {
  id               String   @id @default(uuid()) @db.Uuid
  saleId           String   @map("sale_id") @db.Uuid
  productVariantId String   @map("product_variant_id") @db.Uuid
  quantity         Int
  unitSalePrice    Decimal  @map("unit_sale_price") @db.Decimal(14, 2)
  unitCostSnapshot Decimal  @map("unit_cost_snapshot") @db.Decimal(14, 4)
  lineRevenue      Decimal  @map("line_revenue") @db.Decimal(14, 2)
  lineCost         Decimal  @map("line_cost") @db.Decimal(14, 2)
  lineGrossProfit  Decimal  @map("line_gross_profit") @db.Decimal(14, 2)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  sale           Sale           @relation(fields: [saleId], references: [id], onDelete: Restrict)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@unique([saleId, productVariantId])
  @@index([productVariantId])
  @@map("sale_items")
}

model LoginAttempt {
  key String @id @db.VarChar(64)
  attempts Int
  resetAt DateTime @map("reset_at") @db.Timestamptz(3)

  @@index([resetAt])
  @@map("login_attempts")
}
